# =============================================================
# Copiá este archivo como .env y completá los valores reales.
#   cp .env.example .env
# .env está en .gitignore y nunca se sube al repositorio.
# =============================================================

# -------------------------------------------------------------
# DNS público de la instancia Cloud9
# Ejemplo: abc123.vfs.cloud9.us-east-1.amazonaws.com
# -------------------------------------------------------------
CLOUD9_PUBLIC_DNS=tu-dns-publico.vfs.cloud9.us-east-1.amazonaws.com

# -------------------------------------------------------------
# MLflow (terminal 1 — puerto 5000)
# -------------------------------------------------------------
MLFLOW_TRACKING_URI=http://${CLOUD9_PUBLIC_DNS}:5000

# -------------------------------------------------------------
# API FastAPI (terminal 2 — puerto 8000)
# -------------------------------------------------------------
API_PUBLIC_URL=http://${CLOUD9_PUBLIC_DNS}:8000

# URI del modelo registrado en MLflow.
# Usar el alias champion o una versión numérica específica:
#   models:/imdb-spanish-sentiment@champion
#   models:/imdb-spanish-sentiment/3
MODEL_URI=models:/imdb-spanish-sentiment@champion

# -------------------------------------------------------------
# Kaggle — necesario para descargar el dataset la primera vez.
# Generá tu API key en: kaggle.com → Account → API → Create New Token
# -------------------------------------------------------------
KAGGLE_USERNAME=tu_usuario_de_kaggle
KAGGLE_KEY=tu_api_key_de_kaggle
